# CHDS — environment variables. Set them in Vercel → Project → Settings → Environment Variables, then Redeploy.
# NEVER commit real values. Everything below is server-only: none of it is sent to the browser.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...                   # service_role key (SECRET). SUPABASE_SERVICE_ROLE_KEY is accepted too.
# SUPABASE_ANON_KEY=eyJ...                    # optional/unused: the browser never talks to Supabase directly (all access goes through /api)

# --- Telegram ---
BOT_TOKEN=123456:ABC...                       # from @BotFather. TELEGRAM_BOT_TOKEN is accepted too.
WEBHOOK_SECRET=change-me-long-random-A-Za-z0-9_-   # protects /api/telegram, /api/setup and /api/health details
TELEGRAM_TEAM_UIDS=8467682122,6656858850,6325935745   # CHDS team: comma separated numeric Telegram user IDs. Spaces are ignored,
#                                             # invalid entries are reported by /api/health and `npm run check:env` (never printed).
#                                             # These IDs (minus members deactivated in Team Management) may use the bot AND the
#                                             # private report portal (/report-portal). Example: 8467682122,6656858850,6325935745
ALLOWED_UIDS=                                 # (existing) team members allowed to use the bot; merged with TELEGRAM_TEAM_UIDS
ADMIN_UIDS=111111111                          # founders / super admins: full dashboard access + report approval
#                                             # V6: founders hold delete_reports (permanent deletion); grant it to others in Roles & Permissions
# TELEGRAM_COMMAND_LANGS=es,ms                # V6, optional: extra 2-letter language codes whose old bot command menus are cleared on
#                                             # "Connect Telegram bot" (none/en/tl are always cleared). See TELEGRAM_COMMANDS.md

# --- AI (Groq) ---
GROQ_API_KEY=gsk_...
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b   # optional (this is the default order)

# --- Dashboard security ---
SESSION_SECRET=                               # 40+ random characters (minimum 24). Used to hash session tokens and codes.
ADMIN_PASSWORD=                               # password for ADMIN_UIDS founders without a personal password (min 12 chars)
# ADMIN_IDLE_MIN=10                           # auto sign-out after N idle minutes (default 10, max 120); 8 h absolute limit
# ENCRYPTION_KEY=                             # reserved: not used by this version (no field-level encryption is implemented)

# --- Application ---
APP_URL=https://your-site.vercel.app          # public URL: "Open in dashboard" links in Telegram alerts and the /portal link the bot sends
CURRENCY=₱                                    # optional, default ₱
TZ_OFFSET=8                                   # optional, hours from UTC for report dates (Philippines = 8)
# AUTO_APPROVE                                # retired in V5: it applied to Telegram /report, which was removed. Reports are submitted
#                                             # on the private website portal (/report-portal) and always start as Pending.
# ALLOWED_ORIGIN=https://yourdomain.com       # optional CORS origin. Note: AI Support identity needs the same domain.
